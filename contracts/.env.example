# Salin file ini menjadi ".env" (tanpa .example) lalu isi nilainya.
# JANGAN PERNAH meng-upload file .env ke GitHub (sudah diabaikan oleh .gitignore).

# URL RPC Sepolia. Boleh pakai publik (default) atau dari Alchemy/Infura (lebih stabil).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Kunci privat dompet DEPLOYER (akun MetaMask khusus testnet, BUKAN dompet berisi uang asli).
# MetaMask > titik tiga di akun > Account details > Show private key. Awali dengan 0x.
DEPLOYER_PRIVATE_KEY=

# Alamat dompet ARBITER (akun MetaMask "Arbiter"). Harus berbeda dari akun Klien dan Freelancer.
ARBITER_ADDRESS=

# true  = mode DEMO: 1 hari = 60 detik (review 3 menit, jendela revisi 3 menit, tenggat arbiter 7 menit)
# false = mode SKRIPSI: 1 hari = 86.400 detik (review 3 hari, revisi 3 hari, arbiter 7 hari)
DEMO_MODE=true

# (Opsional) untuk verifikasi kode di Etherscan: npx hardhat verify --network sepolia <alamat> <argumen...>
ETHERSCAN_API_KEY=
