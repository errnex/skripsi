{
  "name": "freelance-escrow-contracts",
  "version": "1.0.0",
  "description": "Smart contract FreelanceEscrow (Hardhat) - escrow per milestone dan denda keterlambatan otomatis",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true GAS_REPORT_FILE=../docs/gas-report.txt hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "e2e:local": "hardhat run scripts/e2e-local.ts --network localhost",
    "check:sepolia": "hardhat run scripts/check-balance.ts --network sepolia",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "skip": "hardhat time-skip --network localhost --seconds"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^18.0.6",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
