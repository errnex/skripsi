# Salin menjadi ".env" (tanpa .example) untuk dijalankan di laptop.
# Di Vercel, isi variabel yang sama di Project Settings > Environment Variables.

# Jaringan yang dipakai website: "sepolia" (default) atau "localhost" (Hardhat node).
VITE_NETWORK=sepolia

# (Opsional) RPC Sepolia untuk MEMBACA data. Default: https://ethereum-sepolia-rpc.publicnode.com
VITE_SEPOLIA_RPC_URL=

# (Opsional) JWT Pinata untuk upload ke IPFS sungguhan. Jika kosong, website memakai
# MODE DEMO IPFS: berkas disimpan di browser dan CID dihitung lokal (tidak dipin ke IPFS).
# Buat key dengan izin minimal (Files: Write) dan hapus/rotasi setelah demo,
# karena variabel VITE_ dapat dilihat siapa pun yang membuka website.
VITE_PINATA_JWT=

# (Opsional) Gateway Pinata milikmu, mis. nama-gateway.mypinata.cloud (tanpa https://)
VITE_PINATA_GATEWAY=

# (Opsional) RPC khusus membaca riwayat transaksi (eth_getLogs). Default: https://sepolia.gateway.tenderly.co
VITE_SEPOLIA_LOGS_RPC_URL=
